{
  "compilerOptions": {
    "outDir": "./dist/",
    "noImplicitAny": true,
    "sourceMap": true,
    "module": "esNext",
    "moduleResolution": "bundler",
    "target": "es2020",
    "jsx": "react",
    "allowJs": true,
    "lib": [
      "es2021",
      "dom",
      "dom.iterable"
    ]
  },
  "exclude": [
    "node_modules",
    "lib",
    "dist",
    "test/bundlers"
  ]
}
