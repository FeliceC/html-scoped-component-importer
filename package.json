{
  "name": "html-scoped-component-importer",
  "version": "3.2.0",
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "lib",
    "bin",
    "CHANGELOG.md"
  ],
  "bin": {
    "html-scoped-component-importer": "bin/init.mjs"
  },
  "license": "MIT",
  "packageManager": "yarn@1.22.22",
  "description": "Async html scoped components dispatcher",
  "repository": "https://github.com/FeliceC/html-scoped-component-importer",
  "author": "Felice Caricati <felice.caricati@gmail.com> (https://www.felicecaricati.com)",
  "homepage": "https://felicec.github.io/html-scoped-component-importer/",
  "scripts": {
    "start": "webpack-dev-server --mode development --open",
    "build": "webpack --mode production",
    "build:demo": "webpack --mode development --no-devtool",
    "build:lib": "node -e \"require('fs').rmSync('lib', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepublishOnly": "yarn build:lib",
    "test:unit": "vitest run",
    "test:e2e": "yarn build && jest",
    "test": "yarn test:unit && yarn test:e2e",
    "jest": "jest",
    "serve": "node server.js",
    "prepare": "husky",
    "bench": "node benchmark/run.mjs",
    "test:bundlers": "yarn build:lib && node test/bundlers/run.mjs && jest --testPathIgnorePatterns=/node_modules/ --testPathPatterns=test/bundlers"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.4.0",
    "express": "^5.2.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "highlight.js": "^11.12.0",
    "html-webpack-plugin": "^5.6.7",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-puppeteer": "^11.0.0",
    "puppeteer": "^25.1.0",
    "rollup": "^4.67.4",
    "rollup-plugin-esbuild": "^6.2.1",
    "ts-loader": "^9.5.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "webpack-dev-middleware": "^8.0.3",
    "webpack-dev-server": "^6.1.0"
  },
  "browserslist": [
    "Chrome >= 92",
    "Firefox >= 95",
    "Safari >= 15.4",
    "Edge >= 92",
    "iOS >= 15.4"
  ]
}
