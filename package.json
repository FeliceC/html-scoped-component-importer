    "@eslint/js": "^9.0.0",
    "babel-loader": "^10.1.1",
    "core-js": "^3.49.0",
    "eslint": "^10.4.0",
    "express": "^5.2.1",
    "globals": "^16.0.0",
    "happy-dom": "^20.9.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.7",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-puppeteer": "^11.0.0",
    "pinst": "^3.0.0",
    "puppeteer": "^25.1.0",
    "ts-loader": "^9.5.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.8",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "webpack-dev-middleware": "^8.0.3",
    "webpack-dev-server": "^5.2.4"
  },
